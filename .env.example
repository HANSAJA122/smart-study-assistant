# Database - PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/study_assistant?schema=public"

# NextAuth / Auth.js — public site URL (no trailing slash)
# Local: use http://localhost:3000
# Vercel: use your real URL, e.g. https://your-app.vercel.app or https://your-domain.com
# If unset on Vercel, VERCEL_URL is used automatically. Do NOT set AUTH_URL or NEXTAUTH_URL to localhost on Vercel (middleware would redirect to localhost).
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Optional: same origin as AUTH_URL for client-side absolute URLs (e.g. https://your-app.vercel.app)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optional — omit both to hide "Continue with Google" and disable the provider)
# Create OAuth 2.0 credentials in Google Cloud Console (Web application).
# Authorized redirect URI must include: {AUTH_URL}/api/auth/callback/google
# Example local: http://localhost:3000/api/auth/callback/google
# Example production: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Vercel (Production) — set these in: Project → Settings → Environment Variables ──
# Production:
#   AUTH_SECRET           = same strong secret as local (openssl rand -base64 32)
#   AUTH_URL              = https://YOUR-PROJECT.vercel.app   OR your custom domain (no trailing slash)
#   NEXTAUTH_URL          = set to the SAME value as AUTH_URL (avoids OAuth redirect_uri mismatch with Google)
#   GOOGLE_CLIENT_ID      = same Web client ID as local (or a prod-only client with matching redirect URIs)
#   GOOGLE_CLIENT_SECRET  = matching secret
#   DATABASE_URL          = your Neon / Postgres URL
# Plus your Ollama / other vars.
#
# Google Cloud Console → Credentials → OAuth 2.0 Client → Authorized redirect URIs MUST include exactly:
#   https://YOUR-PROJECT.vercel.app/api/auth/callback/google
# If you use a custom domain, add that line too, e.g.:
#   https://app.yourdomain.com/api/auth/callback/google
# Authorized JavaScript origins: https://YOUR-PROJECT.vercel.app (and custom domain if used)
#
# Do not set AUTH_URL to localhost on Vercel (this repo strips it). Prefer an explicit https AUTH_URL.
# Preview deployments (branch URLs) each need their own redirect URI in Google unless you only test Google on Production.

# ── Ollama Configuration ─────────────────────────────────────────────
# OLLAMA_BASE_URL is required. OLLAMA_API_KEY is required for cloud.

# Cloud mode:
OLLAMA_BASE_URL="https://ollama.com"
OLLAMA_API_KEY="your-ollama-cloud-api-key"
OLLAMA_MODEL="gemma3:4b"

# Optional API hardening (defaults are safe if unset):
# AI_RATE_LIMIT_PER_MINUTE=15
# REGISTER_RATE_LIMIT_PER_MINUTE=10
# API_STRICT_ORIGIN=1   # reject POST/PUT if Origin does not match AUTH_URL (strict; enable only if all clients send Origin)

# Local mode (uncomment these, comment out cloud above):
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_API_KEY=""
# OLLAMA_MODEL="gemma3"
