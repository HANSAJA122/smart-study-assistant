generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  subjects   Subject[]
  notes      Note[]
  quizzes    Quiz[]
  flashcards Flashcard[]
  studyPlans StudyPlan[]
  progress   Progress[]
  chatMessages ChatMessage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  userId    String
  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes      Note[]
  quizzes    Quiz[]
  flashcards Flashcard[]
  studyPlans StudyPlan[]
  progress   Progress[]
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  summary   String?
  fileName  String?
  subjectId String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model Quiz {
  id        String         @id @default(cuid())
  title     String
  subjectId String?
  userId    String
  score     Int?
  total     Int            @default(0)
  createdAt DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions QuizQuestion[]
}

model QuizQuestion {
  id            String   @id @default(cuid())
  question      String
  options       String[]
  correctAnswer Int
  userAnswer    Int?
  quizId        String

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id        String   @id @default(cuid())
  front     String
  back      String
  subjectId String?
  userId    String
  mastered  Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model StudyPlan {
  id          String    @id @default(cuid())
  title       String
  description String?
  subjectId   String?
  userId      String
  startDate   DateTime
  endDate     DateTime
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  tasks   StudyTask[]
}

model StudyTask {
  id          String   @id @default(cuid())
  title       String
  completed   Boolean  @default(false)
  dueDate     DateTime?
  studyPlanId String

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
}

model Progress {
  id           String   @id @default(cuid())
  userId       String
  subjectId    String?
  type         String
  score        Int
  totalTime    Int      @default(0)
  date         DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
